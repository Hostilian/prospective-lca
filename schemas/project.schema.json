{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/awam-prospective-lca/project.schema.json",
  "title": "AWAM Prospective LCA Workbench Project",
  "type": "object",
  "required": ["id", "name", "description", "synthetic_only", "baseline_scenario_id", "study", "impact_categories", "choices", "inventory", "scenarios"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "synthetic_only": {"type": "boolean"},
    "baseline_scenario_id": {"type": "string", "minLength": 1},
    "study": {"type": "object"},
    "impact_categories": {"type": "object", "minProperties": 1},
    "choices": {"type": "array", "items": {"type": "object", "required": ["id", "category", "statement", "status"]}},
    "inventory": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "stage", "layer", "quantity", "unit", "factors", "source"]}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "year", "pathway", "geography", "foreground_id", "background_id", "narrative"]}}
  }
}
